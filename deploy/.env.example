# ===== OpsPilot 部署配置模板 =====
# 复制为 .env 后修改密码/密钥项；.env 仅保存在部署机，不入库。

# --- 对外端口 ---
NGINX_HTTP_PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=please-change-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=opspilot
MYSQL_PASSWORD=please-change-db-password
MYSQL_DB=opspilot

# --- Redis（内网 compose 网络内使用，默认无密码） ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- 安全密钥（上线前必改）---
# JWT 签名密钥：建议 openssl rand -hex 32 生成
JWT_SECRET_KEY=please-change-jwt-secret
# 字段级加密主密钥（AES-256-GCM，用于 MFA secret 和 SSH 凭据）：
# openssl rand -base64 32 生成；留空则从 JWT_SECRET_KEY 派生并在日志告警
SECRET_ENCRYPT_KEY=

# --- 令牌时效（可选，默认如下）---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MFA_TOKEN_MINUTES=5
PWD_CHANGE_TOKEN_MINUTES=10
# 密码重置令牌有效期（分钟）
RESET_TOKEN_TTL_MINUTES=30
# 邮件中的密码重置链接公共地址
PUBLIC_BASE_URL=http://localhost:8080

# --- 初始管理员（可选：留空则随机生成并打印到 api 容器日志）---
ADMIN_INITIAL_PASSWORD=

# --- 审计、日志与执行 ---
AUDIT_RETENTION_DAYS=365
EXEC_LOG_DIR=/data/logs
# 全局执行并发默认值（首次启动写入 exec.global_concurrency，后续以系统配置为准）
EXEC_GLOBAL_CONCURRENCY_DEFAULT=50

# --- 开发跨域（仅本地开发 vite 直连 api 时需要；生产走 nginx 同源无需修改）---
CORS_ORIGINS=http://localhost:5173

# --- 调试 ---
DEBUG=false
